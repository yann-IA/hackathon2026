{
  "name": "hackathon2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Claire, avatar 3D d'accueil du Hackathon 2026 : questions sur l'événement à partir de ses documents (RAG), entièrement local sur un Mac",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-avatar": "node scripts/fetch-avatar.mjs",
    "build-vrma": "node scripts/build-vrma.mjs",
    "build-avatars": "node scripts/build-avatars.mjs",
    "server": "node server/index.mjs",
    "index": "node server/index.mjs --index-only",
    "start": "npm run build && npm run server",
    "resume": "node server/report.mjs",
    "essai-mail": "node server/report.mjs --essai-mail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "three": "^0.186.1",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "iwer": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
