# Réglages du serveur de l'assistante : copier ce fichier en « server/.env » puis l'adapter.

# L'assistante et l'événement
ASSISTANT_NAME=Claire
EVENT_NAME=Hackathon 2026
EVENT_CONTACT=l'équipe d'organisation

# Port local du serveur (le tunnel Tailscale Funnel ou Cloudflare pointe dessus)
PORT=8090
HOST=127.0.0.1

# Modèle de langue (Ollama). Plus petit = plus rapide ; Mistral répond très bien en français.
LLM_API=ollama
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=mistral-nemo
# Modèles qui « réfléchissent » avant de répondre (qwen3…) : décommenter pour répondre plus vite
# LLM_THINK=false

# Empreintes de sens pour la recherche dans les documents (multilingue)
EMBED_MODEL=bge-m3

# Voix (Kokoro-FastAPI) : voix française féminine
TTS_URL=http://127.0.0.1:8880/v1
TTS_VOICE=ff_siwis
TTS_SPEED=1.05

# Écoute (whisper-server de whisper.cpp), utilisée quand le navigateur ne reconnaît pas la voix
STT_API=whispercpp
STT_URL=http://127.0.0.1:8178/inference

# Protection : réponses en parallèle, file d'attente, questions par minute et par appareil
MAX_CONCURRENT=2
MAX_QUEUE=30
MAX_PER_MINUTE=10

# Journal des questions (anonyme : date, question, réponse) dans Questions.csv, à la racine du projet
# LOG_QUESTIONS=false

# Résumé des questions envoyé par e-mail : analyse des préoccupations et questions sans réponse.
# Fréquence : hebdomadaire (REPORT_DAY : 1 = lundi … 0 = dimanche), quotidien ou jamais.
REPORT_EMAIL=
REPORT_SCHEDULE=hebdomadaire
REPORT_DAY=1
REPORT_HOUR=8
# Compte qui envoie l'e-mail. Gmail : SMTP_USER = l'adresse Gmail, SMTP_PASS = un « mot de passe
# d'application » (https://myaccount.google.com/apppasswords, validation en deux étapes requise),
# pas le mot de passe habituel du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
